{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/changebench/scenario-1.0.json",
  "title": "ChangeBench Scenario",
  "type": "object",
  "required": ["schema_version", "id", "title", "domain", "evidence_class", "mutation_boundary", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "evidence_class": {"enum": ["implemented", "deployed", "simulated", "contract"]},
    "mutation_boundary": {
      "type": "object",
      "required": ["allowed_actions"],
      "properties": {"allowed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "checks": {"type": "array", "minItems": 1}
  }
}

